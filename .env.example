# =========================================================
# DELFSA environment configuration
# Copy this file to .env and adjust values before running
# `docker compose up`. Never commit the real .env file.
# =========================================================

# --- General ---
COMPOSE_PROJECT_NAME=delfsa
DELFSA_ENV=lab
LOG_LEVEL=INFO

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=delfsa
POSTGRES_USER=delfsa
POSTGRES_PASSWORD=change_me_postgres_password

# --- Elasticsearch / Kibana ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Reverse proxy ---
REVERSE_PROXY_PORT=8080

# --- SIEM pipeline tuning ---
LOG_SHIPPER_POLL_INTERVAL=2
LOG_SHIPPER_WATCH_DIR=/var/log/delfsa-sources
CORRELATION_WINDOW_SECONDS=300
CORRELATION_THRESHOLD=3
INCIDENT_COOLDOWN_SECONDS=120
HEALTHCHECK_MAX_STALENESS=60
